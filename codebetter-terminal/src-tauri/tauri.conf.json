{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeBetter",
  "version": "0.1.0",
  "identifier": "com.codebetter.terminal",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeBetter",
        "width": 1040,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "backgroundColor": "#040804"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
